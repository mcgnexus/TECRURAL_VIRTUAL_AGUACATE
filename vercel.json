{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "app:app"
    },
    "frontend": {
      "root": "web/",
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "backend", "format": "url", "env": "BACKEND_URL" }
      ]
    }
  },
  "functions": {
    "backend/app.py": { "maxDuration": 60 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "frontend" } }]
}
